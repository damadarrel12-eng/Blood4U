rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isConversationParticipant(conversationId) {
      let conversation = get(
        /databases/$(database)/documents/conversations/$(conversationId)
      );
      return signedIn()
        && conversation.data.participants is list
        && request.auth.uid in conversation.data.participants;
    }

    match /users/{userId} {
      allow get, list: if signedIn() && request.auth.uid == userId;

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'contact', 'bloodType',
          'isDonorAvailable', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.contact is string
        && request.resource.data.contact.size() <= 32
        && request.resource.data.bloodType in [
          'A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-'
        ]
        && request.resource.data.isDonorAvailable == false
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isDonorAvailable'])
        && request.resource.data.isDonorAvailable is bool;

      allow delete: if false;
    }

    match /donors_public/{donorId} {
      allow get, list: if signedIn();

      allow create, update: if signedIn()
        && request.auth.uid == donorId
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'bloodType', 'area', 'isAvailable', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name
          == getAfter(/databases/$(database)/documents/users/$(donorId)).data.name
        && request.resource.data.bloodType
          == getAfter(/databases/$(database)/documents/users/$(donorId)).data.bloodType
        && request.resource.data.area is string
        && request.resource.data.area.size() <= 100
        && request.resource.data.isAvailable == true
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(donorId))
          .data.isDonorAvailable == true;

      allow delete: if signedIn()
        && request.auth.uid == donorId
        && getAfter(/databases/$(database)/documents/users/$(donorId))
          .data.isDonorAvailable == false;
    }

    match /blood_requests/{requestId} {
      allow get, list: if signedIn() && resource.data.status == 'open';

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'requesterId', 'bloodType', 'hospitalName', 'area',
          'details', 'status', 'createdAt'
        ])
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.bloodType in [
          'A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-'
        ]
        && request.resource.data.hospitalName is string
        && request.resource.data.hospitalName.size() > 0
        && request.resource.data.hospitalName.size() <= 100
        && request.resource.data.area is string
        && request.resource.data.area.size() > 0
        && request.resource.data.area.size() <= 100
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn()
        && resource.data.requesterId == request.auth.uid
        && resource.data.status == 'open'
        && request.resource.data.status == 'closed'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status']);

      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow get: if signedIn()
        && (!exists(
          /databases/$(database)/documents/conversations/$(conversationId)
        ) || request.auth.uid in resource.data.participants);
      allow list: if signedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['participants', 'createdAt'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;

      match /messages/{messageId} {
        allow get, list: if isConversationParticipant(conversationId);

        allow create: if isConversationParticipant(conversationId)
          && request.resource.data.keys().hasOnly([
            'text', 'senderId', 'createdAt'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }
  }
}
